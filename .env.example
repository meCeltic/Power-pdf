# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-4-hydrogen
GEMINI_EMBED_MODEL=gemini-embedding-001
# Any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres (Neon). Vercel injects both when you connect a Neon store to the project.
# DATABASE_URL is the pooled URL, DATABASE_URL_UNPOOLED the direct one (used by Prisma for schema changes).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional locally. When set, PDFs go to Vercel Blob instead of ./uploads.
# Injected automatically when you connect a Blob store on Vercel.
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store's access mode (default: private)
# BLOB_ACCESS=private
